        "id": "rosa_viento",
        "type": "ui_template",
        "z": "1687249fd86a6d01",
        "group": "6f41664fbe4c7a68",
        "name": "Rosa viento",
        "order": 8,
        "width": "7",
        "height": "7",
        "format": "<div style=\"text-align:center\">\n\n    <div style=\"position:relative; width:260px; height:260px; margin:auto;\">\n\n        <!-- ROSA DE LOS VIENTOS -->\n        <svg width=\"260\" height=\"260\" style=\"position:absolute; left:0; top:0;\">\n\n            <!-- círculo exterior -->\n            <circle cx=\"130\" cy=\"130\" r=\"120\" stroke=\"#333\" stroke-width=\"2\" fill=\"none\" />\n\n            <!-- líneas cardinales -->\n            <line x1=\"130\" y1=\"10\" x2=\"130\" y2=\"250\" stroke=\"#ccc\" />\n            <line x1=\"10\" y1=\"130\" x2=\"250\" y2=\"130\" stroke=\"#ccc\" />\n\n            <!-- diagonales -->\n            <line x1=\"40\" y1=\"40\" x2=\"220\" y2=\"220\" stroke=\"#eee\" />\n            <line x1=\"220\" y1=\"40\" x2=\"40\" y2=\"220\" stroke=\"#eee\" />\n\n            <!-- etiquetas -->\n            <text x=\"130\" y=\"10\" text-anchor=\"middle\" font-size=\"14\">N</text>\n            <text x=\"130\" y=\"260\" text-anchor=\"middle\" font-size=\"14\">S</text>\n            <text x=\"254\" y=\"135\" text-anchor=\"middle\" font-size=\"14\">E</text>\n            <text x=\"4\" y=\"135\" text-anchor=\"middle\" font-size=\"14\">O</text>\n\n            <text x=\"222\" y=\"46\" text-anchor=\"middle\" font-size=\"12\">NE</text>\n            <text x=\"220\" y=\"226\" text-anchor=\"middle\" font-size=\"12\">SE</text>\n            <text x=\"40\" y=\"226\" text-anchor=\"middle\" font-size=\"12\">SO</text>\n            <text x=\"40\" y=\"42\" text-anchor=\"middle\" font-size=\"12\">NO</text>\n\n        </svg>\n\n        <!-- AGUJA -->\n        <div id=\"needle\" style=\"\n            width:4px;\n            height:110px;\n            background:red;\n            position:absolute;\n            top:20px;\n            left:128px;\n            transform-origin:bottom center;\n            transform: rotate(0deg);\n            transition: transform 0.3s ease;\n            z-index:10;\n        \"></div>\n\n        <!-- centro -->\n        <div style=\"\n            width:12px;\n            height:12px;\n            background:black;\n            border-radius:50%;\n            position:absolute;\n            top:124px;\n            left:124px;\n            z-index:11;\n        \"></div>\n\n    </div>\n    <!--\n    <div style=\"margin-top:10px;font-size:18px;\">\n        <span id=\"value\">--</span>\n    </div>\n    -->\n</div>\n\n<script>\n    (function(scope) {\n    /*\n    function getDir(deg){\n        const dirs = [\"N\",\"NE\",\"E\",\"SE\",\"S\",\"SO\",\"O\",\"NO\"];\n        return dirs[Math.round(deg / 45) % 8];\n    }\n    */\n    scope.$watch('msg.payload', function(deg) {\n\n        if (deg === undefined || deg === null) return;\n\n        let value = Number(deg);\n\n        if (isNaN(value)) return;\n\n        value = ((value % 360) + 360) % 360;\n\n        document.getElementById(\"needle\").style.transform =\n            \"rotate(\" + value + \"deg)\";\n\n        //document.getElementById(\"value\").innerText =\n        //    value.toFixed(0) + \"° (\" + getDir(value) + \")\";\n\n    });\n\n})(scope);\n</script>",
